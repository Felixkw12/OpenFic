{
  "id": "prompt-elements",
  "name": "动态提示词元素",
  "version": "1.3.0",
  "api_version": 1,
  "description": "按上下文、用户消息、系统片段和规则动态开关提示词元素，并支持注入、替换、移除和预览。",
  "author": "OpenFic",
  "entry": "main.py",
  "resources": [],
  "capabilities": [
    "projects.read",
    "storage",
    "events",
    "ui",
    "agent.hooks",
    "editor.read",
    "editor.write"
  ],
  "views": [
    {
      "id": "rules",
      "title": "动态提示词元素",
      "slot": "sidebar.extensions",
      "renderer": "declarative",
      "render": "ui.render",
      "action": "ui.action"
    },
    {
      "id": "switches",
      "title": "提示词开关",
      "slot": "assistant.above-prompt",
      "renderer": "declarative",
      "render": "ui.render",
      "action": "ui.action"
    },
    {
      "id": "editor",
      "title": "提示词与编辑器",
      "slot": "editor.toolbar",
      "renderer": "declarative",
      "render": "ui.render",
      "action": "ui.action",
      "icon": "TextCursorInput",
      "presentation": "popover"
    }
  ],
  "settings": []
}
